map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream pragma_backend {
    server ${PRAGMA_BACKEND_UPSTREAM};
    keepalive 16;
}

server {
    listen ${PRAGMA_PROXY_LISTEN_PORT};
    server_name ${PRAGMA_SERVER_NAME};
    root /usr/share/nginx/html;

    client_max_body_size ${PRAGMA_PROXY_CLIENT_MAX_BODY_SIZE};

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # If this proxy terminates TLS, enable HSTS only after confirming the
    # public hostname and any included subdomains are HTTPS-only:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location = /healthz {
        access_log off;
        proxy_pass http://pragma_backend/api/v1/system/health;
    }

    location = /readyz {
        access_log off;
        proxy_pass http://pragma_backend/api/v1/system/ready;
    }

    location = /api/v1/realtime/stream {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout ${PRAGMA_PROXY_WEBSOCKET_READ_TIMEOUT};
        proxy_send_timeout ${PRAGMA_PROXY_WEBSOCKET_SEND_TIMEOUT};
        proxy_pass http://pragma_backend;
    }

    location = /api/v1 {
        proxy_pass http://pragma_backend;
    }

    location /api/v1/ {
        proxy_pass http://pragma_backend;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /login {
        try_files /index.html =404;
    }

    location ^~ /login/ {
        try_files /index.html =404;
    }

    location = /setup {
        try_files /index.html =404;
    }

    location ^~ /setup/ {
        try_files /index.html =404;
    }

    location = /app {
        try_files /index.html =404;
    }

    location ^~ /app/ {
        try_files /index.html =404;
    }

    location / {
        proxy_pass http://pragma_backend;
    }
}
