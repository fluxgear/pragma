# Copy to docker/prod.env, replace every placeholder secret, then run:
# docker compose -f docker/docker-compose.yml --env-file docker/prod.env up -d --build

# Image names/tags built locally by the production compose file.
PRAGMA_POSTGRES_IMAGE=pragma-postgres-pg18-vector:prod
PRAGMA_BACKEND_IMAGE=pragma-backend:prod
PRAGMA_PROXY_IMAGE=pragma-proxy:prod

# PostgreSQL 18 + pgvector strategy.
# This image is the explicit pgvector PostgreSQL 18 image; do not replace it with stock postgres:18
# unless you also provide a custom build/install path that makes the vector extension available.
PRAGMA_PGVECTOR_POSTGRES_IMAGE=pgvector/pgvector:pg18@sha256:b48c110f4911eb3d73ba7b6bd8964a5f26be740c2d580158530471c3c0f66487

# Database container initialization and backend connection settings.
PRAGMA_DATABASE_NAME=pragma
PRAGMA_DATABASE_USER=pragma
PRAGMA_DATABASE_PASSWORD=replace-with-a-random-database-password
# File-secret alternative: leave PRAGMA_DATABASE_PASSWORD empty, set
# PRAGMA_DATABASE_PASSWORD_FILE=/run/secrets/pragma_database_password, and run compose
# with docker/docker-compose.secrets.yml plus PRAGMA_DATABASE_PASSWORD_SECRET_SOURCE
# pointing to the host-side password file.
# PRAGMA_DATABASE_PASSWORD_FILE=
# PRAGMA_DATABASE_PASSWORD_SECRET_SOURCE=./secrets/pragma_database_password
PRAGMA_DATABASE_ADMIN_DATABASE=postgres
PRAGMA_DATABASE_POOL_MIN_SIZE=1
PRAGMA_DATABASE_POOL_MAX_SIZE=10

# Optional host exposure for operator backups or direct psql access. Keep localhost-only unless needed.
# Choose a host-specific published port for each deployment; do not reuse the
# internal container port 5432 as a copied default.
PRAGMA_DATABASE_PUBLISHED_HOST=127.0.0.1
PRAGMA_DATABASE_PUBLISHED_PORT=

# Backend runtime.
PRAGMA_BACKEND_PORT=8000
PRAGMA_DB_WAIT_TIMEOUT_SECONDS=90
PRAGMA_JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# File-secret alternative: leave PRAGMA_JWT_SECRET_KEY empty, set
# PRAGMA_JWT_SECRET_KEY_FILE=/run/secrets/pragma_jwt_secret_key, and run compose
# with docker/docker-compose.secrets.yml plus PRAGMA_JWT_SECRET_KEY_SECRET_SOURCE
# pointing to the host-side JWT secret file.
# PRAGMA_JWT_SECRET_KEY_FILE=
# PRAGMA_JWT_SECRET_KEY_SECRET_SOURCE=./secrets/pragma_jwt_secret_key
PRAGMA_JWT_ALGORITHM=HS256
PRAGMA_JWT_ACCESS_TOKEN_TTL_MINUTES=15
PRAGMA_JWT_REFRESH_TOKEN_TTL_DAYS=7
PRAGMA_REFRESH_COOKIE_NAME=pragma_refresh_token
PRAGMA_REFRESH_COOKIE_PATH=/api/v1/auth
PRAGMA_REFRESH_COOKIE_SECURE=true
PRAGMA_REFRESH_COOKIE_SAMESITE=lax
PRAGMA_BASE_URL=http://localhost:8080
PRAGMA_RUNTIME_ENVIRONMENT=production
PRAGMA_LOG_LEVEL=INFO
PRAGMA_AI_ALLOW_PRIVATE_BASE_URLS=false

# Local container storage. Compose mounts named volumes at these paths.
PRAGMA_MEDIA_MAX_UPLOAD_BYTES=10485760
PRAGMA_MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,audio/mpeg,audio/wav,audio/ogg,video/mp4,video/webm
PRAGMA_THEME_ACTIVE_ID=default
PRAGMA_THEME_DEFAULT_ID=default
# Default false logs advisory module-trust diagnostics while preserving Docker named-volume compatibility.
PRAGMA_MODULE_TRUST_STRICT=false

# Search, AI embeddings, and realtime behavior.
PRAGMA_SEARCH_ENABLE_SEMANTIC=false
PRAGMA_REALTIME_ENABLED=true
PRAGMA_REALTIME_CHANNEL=pragma_realtime
PRAGMA_REALTIME_QUEUE_SIZE=256
PRAGMA_REALTIME_RECONNECT_MIN_SECONDS=0.5
PRAGMA_REALTIME_RECONNECT_MAX_SECONDS=30.0
PRAGMA_REALTIME_TICKET_TTL_SECONDS=60

# Reverse proxy. The admin build uses /api/v1 by default for same-origin API and websocket routing.
VITE_API_BASE=/api/v1
PRAGMA_PROXY_PUBLISHED_HOST=0.0.0.0
PRAGMA_PROXY_PUBLISHED_PORT=8080
PRAGMA_PROXY_LISTEN_PORT=8080
PRAGMA_PROXY_CLIENT_MAX_BODY_SIZE=25m
PRAGMA_PROXY_WEBSOCKET_READ_TIMEOUT=1h
PRAGMA_PROXY_WEBSOCKET_SEND_TIMEOUT=1h
PRAGMA_SERVER_NAME=_
